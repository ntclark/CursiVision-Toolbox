
#include <windows.h>
#include <winres.h>
#include <commctrl.h>

#include "thisToolBoxResource.h"
#include "resource.h"

#include "versionInfo.h"

VINFO(VFT_DLL)

BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "Comments", "\0"
            VALUE "CompanyName", "EnVisioNate\0"
            VALUE "FileDescription", "The CursiVision Spreadsheet tool. Capture data from the document and store rows of it in a spreadsheet. Can also record the location of the result\0"
            VALUE "FileVersion", CV_PRODUCT_VERSION
            VALUE "InternalName", "SpreadsheetBackEnd.dll\0"
            VALUE "LegalCopyright", "Copyright © 2009-2025 EnVisioNate LLC\0"
            VALUE "LegalTrademarks", "\0"
            VALUE "OriginalFilename", "SpreadsheetBackEnd.dll\0"
            VALUE "PrivateBuild", "\0"
            VALUE "ProductName", "CursiVision Spreadsheet tool\0"
            VALUE "ProductVersion", CV_PRODUCT_VERSION
            VALUE "SpecialBuild", "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END


IDD_NO_PROFILE DIALOGEX 0,0, 400,400
CAPTION "Note"
STYLE DS_SETFONT | WS_CHILD | WS_POPUP | WS_CAPTION
FONT 8, "MS Shell Dlg", 0, 0, 0x0
BEGIN

   LTEXT "",IDDI_NO_PROFILE_NOTE, 8, 8, 16, 16

END

IDD_OPTIONS DIALOGEX 0,0, 460, 512
CAPTION "Note"
STYLE DS_SETFONT | WS_CHILD | WS_POPUP | WS_CAPTION
FONT 8, "MS Shell Dlg", 0, 0, 0x0
BEGIN

   AUTOCHECKBOX "Show these properties every time", IDDI_SHOW_PROPERTIES,10,8,128,14, WS_VISIBLE | WS_TABSTOP

   LTEXT "Please specify the name of your Excel Workbook",-1,   10, 22,246, 12
   EDITTEXT IDDI_WORKBOOK_NAME,                                 10, 34,210, 12, ES_AUTOHSCROLL | WS_TABSTOP
   PUSHBUTTON "...", IDDI_WORKBOOK_GET,                        224, 34, 16, 12

   LTEXT "Please choose the spreadsheet",IDC_STATIC,            10, 54,104, 14
   COMBOBOX IDDI_CHOOSE_SPREADSHEET,                           118, 50, 96, 64, CBS_DROPDOWNLIST | WS_VSCROLL

   LTEXT "Select the field labels from your CursiVision printing profile.",-1,10,72,236,40

   LTEXT "Field name",IDC_STATIC,                               10,  92, 90, 12
   COMBOBOX IDDI_NAME_PREFIX,                                   10, 104, 90, 12, CBS_DROPDOWN | WS_TABSTOP

   LTEXT "Column Name",IDC_STATIC,                             108,  92, 70, 12
   EDITTEXT IDDI_COLUMN_NAME,                                  108, 104, 70, 12, ES_AUTOHSCROLL

   LTEXT "Column ID\r(A,B, etc)",IDC_STATIC,                   186,  84, 40, 16
   EDITTEXT IDDI_COLUMN_ID,                                    186, 104, 40, 12, ES_CENTER

   AUTOCHECKBOX "Include the signing date",IDDI_INCLUDE_DATE,   10,  10, 88, 12, WS_VISIBLE
   RTEXT "Column:",IDDI_INCLUDE_DATE_LABEL,                     10,  10, 32, 12
   EDITTEXT IDDI_DATE_COLUMN_ID,                                10,  10, 32, 12,ES_CENTER

   AUTOCHECKBOX "Include the signing time",IDDI_INCLUDE_TIME,   10,  24, 88, 12, WS_VISIBLE
   RTEXT "Column:",IDDI_INCLUDE_TIME_LABEL,                     10,  10, 32, 12
   EDITTEXT IDDI_TIME_COLUMN_ID,                                10,  10, 32, 12,ES_CENTER

   AUTOCHECKBOX "Include a link to the signed document",IDDI_INCLUDE_DOCUMENT_LINK, 10, 24, 128 + 8, 14
   RTEXT "Column:",IDDI_DOCUMENT_LINK_LABEL,                    10,  10, 32, 14
   EDITTEXT IDDI_DOCUMENT_LINK_COLUMN,                          10,  10, 32,12,ES_CENTER

   LTEXT "",IDDI_TOOLBOX_NEED_ADMIN_PRIVILEGES,0,0,280, 12 
END

STRINGTABLE 
{
   IDS_NO_PROFILE "This CursiVision tool is designed for documents you sign, either .\r\
initiated with the CursiVision print driver or that you open with the file menu.\r\r\
The system can capture text at any location from these documents.\r\r\
When you edit settings for the document you can specify locations\r\
within it from which to find the text in each copy of the document signed.\r\r\
With these definitions, this tool can then take the text from\r\
those locations in the document and populate your spreadsheet with that text.\r\r\
You can do this with any number of locations, and therefore populate multiple \r\
cells in your spreadsheet.\r\r\
When you edit the profile, create fields by going to the Data Fields Settings \r\
Tab on the left, and use the mouse to select each field. Be sure to right click \r\
on each field and create a label for it.\r\r\
After you define these fields, click Ok to save the definitions\r\
to the system, then restart the settings dialog to use them.\r\r\r\
This tool settings option is not available until you've defined\r\
one or more of these data fields"
}
