
#include <windows.h>
#include <winres.h>
#include <commctrl.h>

#include "thisToolResource.h"
#include "resource.h"

#include "versionInfo.h"

VINFO(VFT_DLL)

BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "Comments", "\0"
            VALUE "CompanyName", "EnVisioNate\0"
            VALUE "FileDescription", "The CursiVision File Naming tool. Copy information from the resulting document and use that information to name the saved document.\0"
            VALUE "FileVersion", CV_PRODUCT_VERSION
            VALUE "InternalName", "NamingBackEnd.dll\0"
            VALUE "LegalCopyright", "Copyright © 2009-2025 EnVisioNate LLC\0"
            VALUE "LegalTrademarks", "\0"
            VALUE "OriginalFilename", "NamingBackEnd.dll\0"
            VALUE "PrivateBuild", "\0"
            VALUE "ProductName", "CursiVision File Naming tool\0"
            VALUE "ProductVersion", CV_PRODUCT_VERSION
            VALUE "SpecialBuild", "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

#define SKIP_CURSIVISION_PROPERTIES
#define DONT_TERMINATE_DIALOG_TEMPLATE
#define ADDITIONAL_TOP_SPACE 0
#define DISPOSITION_SETTINGS_WIDTH 512
#define DISPOSITION_SETTINGS_HEIGHT 400

#include "resultDisposition.rc"

   LTEXT "Please specify the storage options for the resulting document:",IDDI_HEADER_TEXT, 10, 5, 256, 12

   LTEXT "Choose the field label from your print profile:",IDC_STATIC,  10, 116, 250, 12
   COMBOBOX IDDI_NAME1_PREFIX,                                          16, 130, 128, 64,WS_VISIBLE | CBS_DROPDOWNLIST

   LTEXT "Optional: Choose another field from your print profile:",IDC_STATIC,  10, 144, 250, 12
   COMBOBOX IDDI_NAME2_PREFIX,                                                  16, 158, 128, 64,WS_VISIBLE | CBS_DROPDOWNLIST

   LTEXT "",IDC_STATIC,10,224, 256, 64

END


IDD_NO_PROFILE DIALOGEX 0,0, 400, 400
CAPTION "Note"
STYLE DS_SETFONT | WS_CHILD | WS_POPUP | WS_CAPTION
FONT 8, "MS Shell Dlg", 0, 0, 0x0
BEGIN

   LTEXT "",IDDI_NO_PROFILE_NOTE, 8, 8, 16, 16

END

STRINGTABLE {

#include "commonStringsStock.rc"

IDDI_NAME1_PREFIX "Create a field in your print profile (Tools - Setup - Print) \r\
that defines a location containing text for the file name."

IDS_NO_PROFILE "This CursiVision tool is designed for documents you sign, either .\r\
initiated with the CursiVision print driver or that you open with the file menu.\r\r\
The system can capture text at any location from these documents.\r\r\
When you edit settings for the document you can specify locations\r\
within it from which to find the text in each copy of the document signed.\r\r\
With these definitions, this tool can then take the text from that location\r\
and name your signed document with that text at that location.\r\r\
When you edit the profile, create fields by going to the Data Fields Settings \r\
Tab on the left, and use the mouse to select each field. Be sure to right click \r\
on each field and create a label for it.\r\r\
After you define these fields, click Ok to save the definitions\r\
to the system, then restart the settings dialog to use them.\r\r\r\
This tool settings option is not available until you've defined\r\
one or more of these data fields"
}
